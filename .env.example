# =============================================================================
# CoreVisys Laravel License Client — example environment variables
# -----------------------------------------------------------------------------
# Copy the values you need into your application's .env and fill them in.
# This file contains PLACEHOLDERS ONLY. Real secrets exist only in the server's
# environment — never in the repository, CI logs, or the published config.
# =============================================================================

# --- Connection --------------------------------------------------------------
# Absolute http(s) URL of the license server. Default: https://license.corevisys.com
# Only set this if you run your own license server.
COREVISYS_LICENSE_SERVER_URL=https://license.corevisys.com
# License server API version segment. Default: v1
COREVISYS_LICENSE_API_VERSION=v1
# Package client version reported to the server. Default: 1.0.0
COREVISYS_LICENSE_CLIENT_VERSION=1.0.0

# --- Credentials -------------------------------------------------------------
# Product identifier issued for your application. REQUIRED.
COREVISYS_PRODUCT_CODE=
# Optional pre-provisioned license key. SECRET — leave empty to activate via the
# built-in activation screen instead. Never commit the real value.
COREVISYS_LICENSE_KEY=

# --- HTTP client -------------------------------------------------------------
# Seconds to wait for the license server. Default: 10
COREVISYS_LICENSE_TIMEOUT=10
# Verify the server TLS certificate. MUST remain true in production. Default: true
COREVISYS_LICENSE_VERIFY_SSL=true
# Hard cap on response body size, bytes. Default: 1048576
COREVISYS_LICENSE_MAX_RESPONSE_BYTES=1048576
# Transient-failure retry policy.
COREVISYS_LICENSE_RETRY_TIMES=3
COREVISYS_LICENSE_RETRY_BASE_DELAY_MS=250
COREVISYS_LICENSE_RETRY_MAX_DELAY_MS=4000

# --- Activation / check behavior --------------------------------------------
# Activate automatically on boot when a key is available. Default: false
COREVISYS_LICENSE_AUTO_ACTIVATE=false
# Register the scheduled license check. Default: true
COREVISYS_LICENSE_AUTO_CHECK=true
# Seconds between scheduled checks. Default: 86400 (daily)
COREVISYS_LICENSE_CHECK_INTERVAL=86400
# Permitted when the server is unreachable. Default: true
COREVISYS_LICENSE_ALLOW_OFFLINE=true

# --- Cache storage -----------------------------------------------------------
# Storage driver: "database" (corevisys_license_cache table) or "cache".
# Default: database
COREVISYS_LICENSE_CACHE_DRIVER=database
# Laravel cache store used when driver is "cache". Empty = application default.
COREVISYS_LICENSE_CACHE_STORE=
# Secondary cache store used ONLY when the primary store fails with a
# connection/query error. A storage location, never a trust shortcut: data read
# from it must still pass full signature + offline verification. Default: file.
# Must differ from COREVISYS_LICENSE_CACHE_STORE in "cache" driver mode.
# Empty = fallback disabled.
COREVISYS_LICENSE_CACHE_FALLBACK_STORE=file

# --- Grace -------------------------------------------------------------------
# Local offline grace window, in hours (non-negative whole number). Default: 72
# May only SHORTEN the server-issued offline boundary, never extend it.
COREVISYS_LICENSE_GRACE_PERIOD=72

# --- Fingerprint -------------------------------------------------------------
# sha256 | hmac-sha256. Default: sha256
COREVISYS_LICENSE_FINGERPRINT_ALGO=sha256
# SECRET used by hmac-sha256. Leave empty unless using hmac-sha256.
COREVISYS_LICENSE_FINGERPRINT_SECRET=

# --- Signature ---------------------------------------------------------------
# Response signature algorithm — RSA-SHA256 only. Default: rsa (do not change).
COREVISYS_LICENSE_SIGNATURE_ALGO=rsa
# Allowed clock skew, seconds. Default: 300
COREVISYS_LICENSE_TIMESTAMP_TOLERANCE=300
# How long a published public-key set is cached, seconds. Default: 86400
COREVISYS_LICENSE_PUBLIC_KEY_TTL=86400

# --- Monitoring --------------------------------------------------------------
# Emit package log events. Default: true
COREVISYS_LICENSE_LOGGING=true
# Log channel used by the package (the spec's "log_channel"). Default: stack
COREVISYS_LICENSE_LOG_CHANNEL=stack

# --- Notifications -----------------------------------------------------------
# Sent ONLY from the scheduled health check (corevisys:license:check).
# Enable failure notifications. Default: false (log-only until enabled).
COREVISYS_LICENSE_NOTIFICATIONS=false
# Delivery channels, comma-separated. Allowed: log, mail. Default: log
COREVISYS_LICENSE_NOTIFICATION_CHANNELS=log
# Mail recipients (comma-separated) used when the "mail" channel is enabled.
COREVISYS_LICENSE_NOTIFICATION_RECIPIENTS=
# Seconds between repeated notifications for the SAME failure reason. Default: 3600
# 0 disables the throttle (every failure notifies); it never suppresses alerts.
COREVISYS_LICENSE_NOTIFICATION_THROTTLE=3600

# --- Routes / UI -------------------------------------------------------------
# Enable the built-in activation screen. Default: true
COREVISYS_LICENSE_UI_ENABLED=true
# URL prefix for the activation routes. Default: license
COREVISYS_LICENSE_UI_PREFIX=license
# Skip license enforcement in the local environment. MUST remain false in production.
COREVISYS_LICENSE_BYPASS_LOCAL=false
