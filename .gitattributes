# Keep distribution archives (composer dist / "Archive" downloads) lean
# by excluding files that are only useful for development of the package
# itself. These paths remain available when installing from source via VCS.
/tests          export-ignore
/phpunit.xml    export-ignore
/docs           export-ignore
/.gitignore     export-ignore
/.gitattributes export-ignore
/.editorconfig  export-ignore
/.phpunit.cache export-ignore
/.phpunit.result.cache export-ignore

# Normalize line endings for all text files in the repository.
* text=auto eol=lf
